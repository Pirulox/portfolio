---
const projects = [
  {
    num: "01",
    title: "Portfolio Personal",
    description:
      "Sitio web personal desarrollado para mostrar proyectos y habilidades de programación. Diseñado con una interfaz limpia, tipografía grande y animaciones fluidas.",
    stack: ["HTML", "CSS", "JavaScript", "GSAP"],
    link: "#",
    year: "2026",
  },
  {
    num: "02",
    title: "Proyectos del Ciclo DAM",
    description:
      "Colección de aplicaciones desarrolladas durante el CFGS de Desarrollo de Aplicaciones Multiplataforma, incluyendo apps multiplataforma, bases de datos y desarrollo web.",
    stack: ["HTML", "CSS", "Java", "SQL", "PHP"],
    link: "https://github.com/Pirulox",
    year: "2024 — 2026",
  },
  {
    num: "03",
    title: "Territorio App",
    description:
      "Aplicación móvil multiplataforma diseñada para la gestión territorial y comunitaria. Permite la visualización de datos geográficos, reportes en tiempo real y optimización de flujos de trabajo locales mediante una interfaz intuitiva y optimizada.",
    stack: ["Dart", "Flutter", "Firebase", "Git"],
    link: "https://github.com/Pirulox/territorio-app",
    year: "2026",
  },
];
---

<section class="projects" id="projects">
  <div class="container">
    <div class="section-divider projects-divider"></div>
    <div class="projects-header">
      <span class="section-number projects-number">02 — Proyectos</span>
      <h2 class="section-title projects-title">Trabajo<br />seleccionado</h2>
    </div>
  </div>

  <div class="projects-track-wrapper" id="projects-track-wrapper">
    <div class="projects-track" id="projects-track">
      {
        projects.map((project) => (
          <a
            href={project.link}
            class="project-card"
            data-cursor-hover
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="project-card-inner">
              <div class="project-card-top">
                <span class="project-num">{project.num}</span>
                <span class="project-year">{project.year}</span>
              </div>

              <div class="project-card-content">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-desc">{project.description}</p>
              </div>

              <div class="project-card-bottom">
                <div class="project-stack">
                  {project.stack.map((tech) => (
                    <span class="project-tech">{tech}</span>
                  ))}
                </div>
                <span class="project-arrow">→</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Divider
  gsap.to(".projects-divider", {
    scaleX: 1,
    duration: 1.5,
    ease: "power3.inOut",
    scrollTrigger: {
      trigger: ".projects",
      start: "top 80%",
    },
  });

  // Header reveal
  gsap.from(".projects-number", {
    y: 30,
    opacity: 0,
    duration: 0.8,
    ease: "power3.out",
    scrollTrigger: {
      trigger: ".projects",
      start: "top 70%",
    },
  });

  gsap.from(".projects-title", {
    y: 60,
    opacity: 0,
    duration: 1,
    ease: "power3.out",
    scrollTrigger: {
      trigger: ".projects",
      start: "top 65%",
    },
  });

  // Horizontal scroll
  const track = document.getElementById("projects-track");
  const wrapper = document.getElementById("projects-track-wrapper");

  if (track && wrapper) {
    // Wait for layout to settle
    requestAnimationFrame(() => {
      const scrollAmount = track.scrollWidth - wrapper.offsetWidth;

      if (scrollAmount > 0) {
        gsap.to(track, {
          x: () => -scrollAmount,
          ease: "none",
          scrollTrigger: {
            trigger: wrapper,
            start: "top 15%",
            end: () => `+=${scrollAmount}`,
            pin: true,
            scrub: 1,
            invalidateOnRefresh: true,
          },
        });
      } else {
        track.classList.add("no-scroll");
      }

      // Cards entrance stagger
      gsap.from(".project-card", {
        opacity: 0,
        y: 60,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        scrollTrigger: {
          trigger: wrapper,
          start: "top 60%",
        },
      });
    });
  }
</script>

<style>
  .projects {
    padding-bottom: 0;
  }

  .projects-header {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .projects-track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .projects-track {
    display: flex;
    gap: 2rem;
    padding: 2rem 2rem 4rem;
    width: max-content;
  }

  .projects-track.no-scroll {
    width: 100%;
    justify-content: center;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  @media (min-width: 768px) {
    .projects-track {
      padding: 2rem 4rem 6rem;
      gap: 2.5rem;
    }
    .projects-track.no-scroll {
      padding-left: 4rem;
      padding-right: 4rem;
    }
  }

  .project-card {
    flex-shrink: 0;
    width: 80vw;
    max-width: 500px;
    min-height: 420px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2.5rem;
    display: flex;
    transition: border-color var(--transition-smooth),
      transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .project-card:hover {
    border-color: var(--border-light);
    transform: translateY(-8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .project-card-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    gap: 1.5rem;
  }

  .project-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-num {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    font-weight: 400;
  }

  .project-year {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .project-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    font-weight: 300;
    line-height: 1.7;
  }

  .project-card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-tech {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .project-card:hover .project-tech {
    border-color: var(--border-light);
    color: var(--text-secondary);
  }

  .project-arrow {
    font-size: 1.5rem;
    color: var(--text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .project-card:hover .project-arrow {
    transform: translate(4px, -4px);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .project-card {
      width: 85vw;
      min-height: 360px;
      padding: 2rem;
    }
  }
</style>
