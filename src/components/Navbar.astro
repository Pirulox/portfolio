---

<nav class="navbar" id="navbar">
  <div class="navbar-inner">
    <a href="#hero" class="navbar-logo link-underline">IZ.</a>
    <div class="navbar-links">
      <a href="#about" class="nav-link link-underline">Sobre mí</a>
      <a href="#projects" class="nav-link link-underline">Proyectos</a>
      <a href="#skills" class="nav-link link-underline">Skills</a>
      <a href="#experience" class="nav-link link-underline">Experiencia</a>
      <a href="#contact" class="nav-link link-underline">Contacto</a>
    </div>

    <!-- Mobile menu toggle -->
    <button class="navbar-toggle" id="navbar-toggle" aria-label="Toggle menu">
      <span class="toggle-line"></span>
      <span class="toggle-line"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="navbar-mobile" id="navbar-mobile">
    <a href="#about" class="nav-link-mobile">Sobre mí</a>
    <a href="#projects" class="nav-link-mobile">Proyectos</a>
    <a href="#skills" class="nav-link-mobile">Skills</a>
    <a href="#experience" class="nav-link-mobile">Experiencia</a>
    <a href="#contact" class="nav-link-mobile">Contacto</a>
  </div>
</nav>

<script>
  import { gsap } from "gsap";

  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("navbar-toggle");
  const mobileMenu = document.getElementById("navbar-mobile");
  let lastScroll = 0;
  let isOpen = false;

  // Hide/show on scroll
  window.addEventListener("scroll", () => {
    const currentScroll = window.scrollY;

    if (currentScroll > 100) {
      if (currentScroll > lastScroll) {
        navbar?.classList.add("navbar-hidden");
      } else {
        navbar?.classList.remove("navbar-hidden");
      }
    } else {
      navbar?.classList.remove("navbar-hidden");
    }

    if (currentScroll > 50) {
      navbar?.classList.add("navbar-scrolled");
    } else {
      navbar?.classList.remove("navbar-scrolled");
    }

    lastScroll = currentScroll;
  });

  // Mobile toggle
  toggle?.addEventListener("click", () => {
    isOpen = !isOpen;
    toggle.classList.toggle("active", isOpen);
    mobileMenu?.classList.toggle("active", isOpen);
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      isOpen = false;
      toggle?.classList.remove("active");
      mobileMenu?.classList.remove("active");
    });
  });
</script>

<style>
  .navbar {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999 !important; /* Forzado absoluto por encima de cualquier animación de GSAP o SVG */
    padding: 1.5rem 2rem;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar-hidden {
    transform: translateY(-100%);
  }

  .navbar-scrolled {
    background: var(--bg-navbar) !important; /* Cristal traslúcido con el color violeta de fondo */
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .navbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .navbar-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.7;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-secondary);
    opacity: 1;
  }

  .navbar-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 4px;
  }

  .toggle-line {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--text);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  .navbar-toggle.active .toggle-line:first-child {
    transform: rotate(45deg) translate(3px, 3px);
  }

  .navbar-toggle.active .toggle-line:last-child {
    transform: rotate(-45deg) translate(3px, -3px);
  }

  .navbar-mobile {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .navbar-mobile.active {
    display: flex;
  }

  .nav-link-mobile {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.7;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .nav-link-mobile:hover {
    color: var(--text-secondary);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .navbar-links {
      display: none;
    }

    .navbar-toggle {
      display: flex;
    }

    .navbar {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
